<Window x:Class="GestionPretBancaire.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nouveau Client" 
        Height="620" 
        Width="460"
        Background="#1F1F1F"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bordure"
                         Background="{TemplateBinding Background}"
                         BorderBrush="Black"
                         BorderThickness="2"
                         CornerRadius="8"
                         Padding="20,5">
                            <ContentPresenter ContentSource="Header"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bordure" Property="Background" Value="#1F1F1F"/>
                                <Setter TargetName="Bordure" Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bordure" Property="Background" Value="#2B2B2B"/>
                                <Setter TargetName="Bordure" Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++  -->

        <Style x:Name="Bouton_Style" TargetType="Button">
            <Setter Property="Background" Value="#1F1F1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bordure"
                         Background="{TemplateBinding Background}"
                         BorderBrush="Black"
                         BorderThickness="2"
                         CornerRadius="8"
                         Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bordure" Property="Background" Value="#2B2B2B"/>
                                <Setter TargetName="Bordure" Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bordure" Property="Background" Value="#1565C0"/>
                                <Setter TargetName="Bordure" Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>




    <Grid Margin="20" Background="#1F1F1F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nom -->
        <TextBlock Grid.Row="0" Text="Nom" Foreground="White" Margin="0,5,0,2"/>
        <TextBox x:Name="txt_Nom" Grid.Row="1" Background="#2B2B2B" Foreground="White"
                 BorderBrush="#1565C0" Padding="5,4" Margin="0,0,0,8"/>

        <!-- Prénom -->
        <TextBlock Grid.Row="2" Text="Prénom" Foreground="White" Margin="0,5,0,2"/>
        <TextBox x:Name="txt_Prenom" Grid.Row="3" Background="#2B2B2B" Foreground="White"
                 BorderBrush="#1565C0" Padding="5,4" Margin="0,0,0,8"/>

        <!-- Ligne Tél / CIN -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Téléphone" Foreground="White" Margin="0,5,0,2"/>
                <TextBox x:Name="txt_Tel" Background="#2B2B2B" Foreground="White"
                         BorderBrush="#1565C0" Padding="5,4"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="CIN" Foreground="White" Margin="0,5,0,2"/>
                <TextBox x:Name="txt_CIN" Background="#2B2B2B" Foreground="White"
                         BorderBrush="#1565C0" Padding="5,4"/>
            </StackPanel>
        </Grid>

        <!-- Email -->
        <TextBlock Grid.Row="5" Text="Email" Foreground="White" Margin="0,5,0,2"/>
        <TextBox x:Name="txt_Email" Grid.Row="6" Background="#2B2B2B" Foreground="White"
                 BorderBrush="#1565C0" Padding="5,4" Margin="0,0,0,8"/>

        <!-- Numéro de compte -->
        <StackPanel Grid.Row="7" VerticalAlignment="Top">
            <TextBlock Text="Numéro de compte" Foreground="White" Margin="0,5,0,2"/>
            <TextBox x:Name="txt_Compte" Background="#2B2B2B" Foreground="White"
                     BorderBrush="#1565C0" Padding="5,4"/>
            <TextBlock Text="Adresse" Foreground="White" Margin="0,10,0,2"/>
            <TextBox x:Name="txt_Adresse" Background="#2B2B2B" Foreground="White"
                     BorderBrush="#1565C0" Padding="5,4" Margin="0,0,0,8"/>
        </StackPanel>

        <!-- Boutons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" 
                    Background="#1F1F1F" Foreground="White"
                    Padding="20,8" Margin="0,0,10,0" Cursor="Hand" Click="Button_Click"/>
            <Button Content="Enregistrer"  
                    Background="#1565C0" Foreground="White"
                    Padding="20,8" Cursor="Hand" Click="Button_Click_1"/>
        </StackPanel>
    </Grid>
</Window>